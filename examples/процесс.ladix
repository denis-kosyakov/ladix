# Полный жизненный цикл процесса (фичи 005/006): два человеческих шага,
# связанных «после». Сценарий с --db (см. MANIFEST, раздел «процесс.ladix»):
#   ladix run      … --db <бд>   — старт инстанса, первая задача 'собрать_заказ'
#   ladix tasks    … --db <бд>   — список открытых задач
#   ladix complete … <task-id> --db <бд> — завершение шага → ПРОБУЖДЕНИЕ следующего
#   ladix tasks    … --db <бд>   — следующая задача 'отгрузить' уже открыта
процесс выдача_заказа(номер_заказа):
    шаг собрать_заказ:
        исполнитель: "комплектовщик"
        присвоить заказ = номер_заказа     # переменная процесса для следующих шагов
    шаг отгрузить после собрать_заказ:
        исполнитель: "логист"

# Императивный запуск: создаём инстанс процесса, печатаем его id
пусть id = запустить процесс выдача_заказа("ЗК-42")
печать("запущена выдача заказа, id:", id)
