# Классификация суммы заказа по порогам
пусть сумма_заказа = 4200
пусть категория = ""              # объявляем заранее: ветки не создают своей области

если сумма_заказа >= 10000:
    категория = "крупный"
иначе если сумма_заказа >= 3000:
    категория = "средний"
иначе:
    категория = "мелкий"

печать("категория:", категория)   # категория: средний

# Условие обязано быть Булево; сравнение даёт Булево
если сумма_заказа % 2 == 0:
    печать("чётная сумма")
иначе:
    печать("нечётная сумма")
