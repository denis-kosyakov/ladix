# НЕГАТИВ (A2 §MW-8): недопустимая единица окна. «последние 5час» — час не входит в
# {дн, нед, мес} для скользящего окна → семантическая ошибка (Analyze), exit 1, §13-канон.

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата
        сумма_заказа: Дробное
        статус: Строка

метрика выручка_окно:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   последние 5час
    по_дате:  дата(дата_заказа)
