# НЕГАТИВ (A2 §MW-8): неизвестный noun завершённого периода. «прошлый век» — век не
# входит в {день, неделя, месяц, квартал, год} → семантическая ошибка (Analyze),
# exit 1, §13-канон.

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата
        сумма_заказа: Дробное
        статус: Строка

метрика выручка_окно:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   прошлый век
    по_дате:  дата(дата_заказа)
