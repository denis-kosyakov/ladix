# Витрина ОШИБКИ схемы источника (010-A1, §SC-9.B): объявленный тип поля НЕ совпадает
# с фактическим значением в данных. Поле `сумма_заказа` объявлено `Целое`, но в
# data/orders.json вторая запись содержит дробное 800000.50 → коэрсия НЕ промоутит
# Дробное в Целое (демоушена нет) → ошибка данных с позицией, exit 1, канон §13.
# Парсится ЧИСТО (ошибка — рантайм-коэрсия при загрузке источника), поэтому НЕ входит
# в обязательный parse-clean-набор как валидная программа? — входит (см. ниже): файл
# синтаксически валиден, падает лишь при вычислении метрики.

источник заказы:
    файл: "data/orders.json"
    тип: json
    поля:
        сумма_заказа: Целое   # НЕВЕРНО: данные содержат дробное 800000.50
        статус: Строка

метрика выручка:
    источник: заказы
    агрегат:  сумма(сумма_заказа)

# Триггер форсирует вычисление метрики → ленивую загрузку источника → коэрсию схемы.
когда метрика выручка < 10_000_000:
    печать("это не напечатается:", значение)
