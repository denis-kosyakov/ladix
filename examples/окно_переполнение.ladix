# НЕГАТИВ (A2 §MW-8): размер окна переполняет Целое (int64). «последние
# 99999999999999999999999дн» — N положителен, но вне диапазона → отдельная
# семантическая ошибка «размер окна слишком велик» (Analyze), exit 1, §13-канон.

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата
        сумма_заказа: Дробное
        статус: Строка

метрика выручка_окно:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   последние 99999999999999999999999дн
    по_дате:  дата(дата_заказа)
