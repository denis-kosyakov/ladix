# Контроль плана с эскалацией дедлайна (фича 016 B4a, §AU-6): процесс с
# человеческим шагом и сроком + триггер эскалации «когда задача просрочена в …».
# «задача»/«просрочена» — обычные идентификаторы (D-AU-4), вид триггера применяет
# парсер по контексту после «когда». Тело эскалации читает переменную процесса
# `факт` (резолв в рантайме демона против переменных инстанса; B4b serve).
#   ladix run … — эскалация-триггер печатает строку-заглушку «требует serve (фича 007b)».
процесс эскалация_плана(факт):
    шаг связаться_с_клиентом:
        исполнитель: "менеджер"
        срок:        3дн
    # Авто-шаги догона после завершения человеческого шага (M3 §C-1, split D-C-5):
    # «захват → durable» отдельно от «реального эффекта в теле шага». payload `данные`
    # эфемерен (на рестарте пуст), поэтому итог фиксируется durable отдельным шагом, а
    # шаг эффекта читает уже durable `итог` → на рестарте эффект переисполняется, но
    # outbox-леджер (exactly-once) глушит повтор — реальный POST в crm РОВНО один раз.
    шаг зафиксировать_итог после связаться_с_клиентом:
        присвоить итог = данные.итог
    шаг уведомить_crm после зафиксировать_итог:
        уведомить crm("итог звонка: " + итог)

когда задача просрочена в эскалация_плана.связаться_с_клиентом:
    уведомить руководитель(факт)

# Запуск инстанса: переменная процесса `факт` доступна телу эскалации в serve.
пусть id = запустить процесс эскалация_плана(2500000)
печать("запущен контроль плана, id:", id)
