# Цикл 'для' по числовому диапазону: сумма чётных чисел 1..10
пусть итог = 0
для i в диапазон(1, 11):          # 1, 2, ..., 10
    если i % 2 != 0:
        продолжить                # пропускаем нечётные
    итог = итог + i
печать("сумма чётных:", итог)     # 30

# Цикл 'для' по списку с накоплением нового списка
пусть цены = [100, 250, 90, 400]
пусть дорогие = []
для цена в цены:
    если цена >= 200:
        добавить(дорогие, цена)
печать("дорогие:", дорогие)       # дорогие: [250, 400]

# Цикл 'пока' с ранним выходом через 'прервать'
пусть n = 1
пока истина:
    если n > 16:
        прервать
    n = n * 2
печать("первая степень двойки > 16:", n)   # 32
