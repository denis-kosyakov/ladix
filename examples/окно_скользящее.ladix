# Скользящее окно (A2): период: последние N <ед> (фича 011-metric-windows).
# Окно «последние 30дн» = полуинтервал (сегодня − 30дн, сегодня] от eval.Clock —
# нижняя граница ИСКЛЮЧЕНА, верхняя (сегодня) включена. Метрика дата-ЗАВИСИМА:
# состав окна берётся от сегодня(), поэтому строгого golden на bare `run` нет —
# детерминизм фиксируется через harness с FixedClock (см. cmd/ladix-тесты).

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата       # строка ГГГГ-ММ-ДД → value.Дата (распознавание дат A1)
        сумма_заказа: Дробное   # «300000» и «800000.50» → Дробное
        статус: Строка

# Выручка по ОПЛАЧЕННЫМ заказам за последние 30 дней (скользящее окно).
метрика выручка_30д:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   последние 30дн
    по_дате:  дата_заказа   # поле уже типизировано как Дата схемой поля: (без обёртки дата())

# Триггер печатает вычисленное значение метрики (fire-if-true, форма 007a).
когда метрика выручка_30д < 10_000_000:
    печать("выручка за 30 дней:", значение)
