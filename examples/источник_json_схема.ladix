# Коннектор источника JSON со СХЕМОЙ (010-A1): тип: json + поля: поверх JSON-массива.
# Схема типизирует поля (в т.ч. распознаёт даты) и валидирует записи; для json она
# опциональна (в отличие от csv/ndjson, где обязательна). Метрика БЕЗ периода/по_дате.

источник заказы:
    файл: "data/orders.json"
    тип: json
    поля:
        дата_заказа: Дата       # строка ГГГГ-ММ-ДД → value.Дата (а не голая Строка)
        сумма_заказа: Дробное   # Целое 1200000 → промоушен в Дробное; 800000.5 → Дробное
        статус: Строка

# Выручка по ОПЛАЧЕННЫМ заказам: 1200000 + 800000.50 + 300000 = 2300000.5
метрика выручка_оплачено:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)

когда метрика выручка_оплачено < 10_000_000:
    печать("выручка оплаченных (JSON+схема):", значение)
