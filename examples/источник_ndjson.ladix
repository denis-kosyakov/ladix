# Коннектор источника NDJSON (010-A1): тип: ndjson + схема поля:.
# Один JSON-объект на строку; пустые строки пропускаются (data/orders.ndjson их содержит).
# Метрика БЕЗ периода/по_дате → значение дата-независимо.

источник заказы:
    файл: "data/orders.ndjson"
    тип: ndjson
    поля:
        дата_заказа: Дата       # строка ГГГГ-ММ-ДД → value.Дата
        сумма_заказа: Дробное   # Целое 1200000 → промоушен в Дробное; 800000.50 → Дробное
        статус: Строка

# Выручка по ОПЛАЧЕННЫМ заказам: 1200000 + 800000.50 + 300000 = 2300000.5
метрика выручка_оплачено:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)

когда метрика выручка_оплачено < 10_000_000:
    печать("выручка оплаченных (NDJSON):", значение)
