# DoD-срез M1 (A2, фича 011-metric-windows): скользящее окно «последние 30дн» над
# CSV-источником data/orders.csv. На FixedClock{2026,6,15} окно (2026-05-16, 2026-06-15]
# оставляет лишь оплаченный заказ 2026-05-27 (300000) — заказы 2026-05-04/05-12
# исключены окном, 2026-05-19 отфильтрован `где` (отменён) → DoD-скаляр 300000.0.
# Метрика дата-ЗАВИСИМА: golden закреплён через harness с FixedClock{2026,6,15}
# (cmd/ladix/metric_window_golden_test.go), а НЕ bare `run` (системные часы).

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата       # строка ГГГГ-ММ-ДД → value.Дата (распознавание дат A1)
        сумма_заказа: Дробное   # «300000» и «800000.50» → Дробное
        статус: Строка

# Выручка по ОПЛАЧЕННЫМ заказам за последние 30 дней (скользящее окно).
метрика выручка_30д:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   последние 30дн
    по_дате:  дата_заказа   # поле уже типизировано как Дата схемой поля: (без обёртки дата())
