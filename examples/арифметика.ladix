# Переменные и арифметика с приоритетами
пусть a = 2 + 3 * 4          # умножение раньше сложения -> 14
пусть b = (2 + 3) * 4        # скобки меняют порядок -> 20
печать(a, b)

# Целочисленное деление и остаток против истинного деления
печать(17 // 5, 17 % 5)      # 3 2
печать(17 / 5)               # 3.4  (/ всегда даёт Дробное)

# Унарный минус и сравнение
пусть x = -5
печать(x * x)                # 25

# Логика с приоритетами: 'и' раньше 'или', сравнения раньше логики
пусть в_диапазоне = x > -10 и x < 0
печать(в_диапазоне)          # истина
печать(не в_диапазоне или a == 14)   # истина
