# Последний завершённый период (A2): период: прошлый <noun> (фича 011-metric-windows).
# «прошлый месяц» = тот же календарный месяц, сдвинутый на −1 (от сегодня() через
# eval.Clock). Метрика дата-ЗАВИСИМА (окно зависит от текущего месяца) — строгого
# golden на bare `run` нет; детерминизм — через harness с FixedClock.

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата
        сумма_заказа: Дробное
        статус: Строка

# Выручка по ОПЛАЧЕННЫМ заказам за прошлый (завершённый) месяц.
метрика выручка_прошлый_месяц:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   прошлый месяц
    по_дате:  дата_заказа   # поле уже типизировано как Дата схемой поля: (без обёртки дата())

# Триггер печатает вычисленное значение метрики (fire-if-true, форма 007a).
когда метрика выручка_прошлый_месяц < 10_000_000:
    печать("выручка за прошлый месяц:", значение)
