# Мультиисточник + мультиметрика в одном файле.
# Два ИСТОЧНИКА (заказы и расходы) и три МЕТРИКИ над ними.
# Метрики БЕЗ периода/по_дате → вывод детерминирован (не зависит от сегодня()):
# на фиксированных данных data/sales.json и data/costs.json значения постоянны.
# Метрика-триггеры (форма 007a) печатают вычисленные значения через `значение`.

# Источник 1: заказы (записи { клиент, дата_заказа, сумма_заказа, статус })
источник заказы:
    файл: "data/sales.json"

# Источник 2: расходы (записи { статья, сумма_расхода, оплачен })
источник расходы:
    файл: "data/costs.json"

# Метрика 1: выручка по оплаченным заказам (без периода → дата-независима)
метрика выручка_оплачено:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)

# Метрика 2: число заказов всего
метрика число_заказов:
    источник: заказы
    агрегат:  количество(сумма_заказа)

# Метрика 3: расходы по оплаченным статьям
метрика расходы_оплачено:
    источник: расходы
    где:      оплачен == "да"
    агрегат:  сумма(сумма_расхода)

# Триггеры печатают вычисленные значения метрик (fire-if-true, форма 007a).
когда метрика выручка_оплачено < 10_000_000:
    печать("выручка оплаченных:", значение)

когда метрика число_заказов < 100:
    печать("всего заказов:", значение)

когда метрика расходы_оплачено < 10_000_000:
    печать("расходы оплаченных:", значение)
