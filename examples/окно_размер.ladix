# НЕГАТИВ (A2 §MW-8): неположительный размер окна. «последние 0дн» — N должен быть ≥ 1
# → семантическая ошибка (Analyze), exit 1, §13-канон.

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата
        сумма_заказа: Дробное
        статус: Строка

метрика выручка_окно:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)
    период:   последние 0дн
    по_дате:  дата(дата_заказа)
