# Коннектор источника CSV (010-A1): тип: csv + схема поля:.
# Первая строка CSV — заголовок; ячейки коэрсятся в объявленные типы.
# Метрика БЕЗ периода/по_дате → значение дата-независимо (не берёт окно от сегодня()).

источник заказы:
    файл: "data/orders.csv"
    тип: csv
    поля:
        дата_заказа: Дата       # строка ГГГГ-ММ-ДД → value.Дата (распознавание дат A1)
        сумма_заказа: Дробное   # «1200000» и «800000.50» → Дробное
        статус: Строка

# Выручка по ОПЛАЧЕННЫМ заказам: 1200000 + 800000.50 + 300000 = 2300000.5
метрика выручка_оплачено:
    источник: заказы
    где:      статус == "оплачен"
    агрегат:  сумма(сумма_заказа)

# Триггер печатает вычисленное значение метрики (fire-if-true, форма 007a).
когда метрика выручка_оплачено < 10_000_000:
    печать("выручка оплаченных (CSV):", значение)
