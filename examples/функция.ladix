# Функция с параметром, ранним возвратом и обычным возвратом
функция средний_чек(заказы):
    если длина(заказы) == 0:
        вернуть 0                 # защита от деления на ноль на пустом списке
    вернуть сумма(заказы) / длина(заказы)

пусть оплаченные = [1500, 2300, 4100, 800]
печать(средний_чек(оплаченные))   # 2175.0  (/ даёт Дробное)
печать(средний_чек([]))           # 0       (ранний возврат, тип Целое)
